# Google Gemini API Key (Required for RAG, Quizzes, Flashcards & Chat)
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your_actual_gemini_api_key_here

# JWT Authentication Secret Key (Random 32-byte string)
SECRET_KEY=generate_a_random_32_byte_hex_string

# Optional: Google OAuth Client ID for Google One-Tap Sign In
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
